# One harmonic-inversion run at the reference point with the margin rule of the verification runs.
[run]
mode = harminv
tag = reference
q_est = 6927                # expected Q; with margin 4.5 the auto rule gives t = 32 000

[analyte]
n = 1.33

[numerics]
resolution = 24
pml = 1.0
symmetry = auto

[source]
fcen = auto                 # a_nm / target_wavelength_nm = 0.31058
fwidth = 0.06
cutoff = 5

[harminv]
t = auto
margin = 4.5
